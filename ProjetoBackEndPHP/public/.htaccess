<IfModule mod_rewrite.c>
    RewriteEngine On

    # Garante o repasse do cabeçalho Authorization para o PHP (fundamental para JWT no Apache/XAMPP)
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    # Encaminha todas as requisições não estáticas para o index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
