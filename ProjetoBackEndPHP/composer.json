{
    "name": "gestao-eventos/backend-php",
    "description": "Backend da API REST em PHP para Gestão de Eventos Escolares (Migrado de C# .NET 8)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "firebase/php-jwt": "^6.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Config\\": "config/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
